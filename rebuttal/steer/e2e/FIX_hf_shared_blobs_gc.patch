--- pod_template.current.sh	2026-11-12 03:11:28
+++ pod_template.sh	2026-11-12 03:11:28
@@ -72,6 +72,10 @@
 export PERSONA_EM_ADAPTER_CACHE="${PERSONA_EM_ADAPTER_CACHE:-/root/.cache/persona_em/adapters}"
 export PYTHONDONTWRITEBYTECODE=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
 export HF_HUB_DOWNLOAD_TIMEOUT="${HF_HUB_DOWNLOAD_TIMEOUT:-60}"
+# huggingface_hub 1.32 stores Xet downloads once in a cache-wide store (hub/blobs/<xx>/<hash>) and
+# links them from models--<repo>/. Deleting models--<repo> then frees nothing, so GC could not make
+# room for the next model. This keeps each repo's files in its own folder, where GC frees them.
+export HF_HUB_DISABLE_SHARED_BLOBS=1
 SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
 if [ -n "${STEER_DIR:-}" ]; then STEER="$STEER_DIR"; else STEER="$STEER_DL/$STEER_PREFIX"; fi
 
